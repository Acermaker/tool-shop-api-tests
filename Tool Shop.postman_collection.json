          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const res = pm.response.json();\r\npm.collectionVariables.set(\"access_token\", res.access_token);\r\n\r\npm.test(\"login successful and token received\", function (){\r\n    pm.response.to.have.status(200);\r\n    pm.expect(res.access_token).to.not.be.empty;\r\n});"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\r\n  \"email\": \"{{user_email}}\",\r\n  \"password\": \"{{test_password}}\"\r\n}\r\n",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/users/login",
          "host": [
