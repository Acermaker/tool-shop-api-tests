  "item": [
    {
      "name": "Registration form fillup",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Random Nepali phone number\r\nconst prefixes = [\"984\",\"985\",\"986\",\"987\",\"988\",\"989\",\"980\",\"981\",\"982\",\"983\"];\r\nconst prefix = prefixes[Math.floor(Math.random() * prefixes.length)];\r\nconst randomDigits = Math.floor(1000000 + Math.random() * 9000000);\r\npm.environment.set(\"nepal_phone\", prefix + randomDigits.toString());\r\n\r\n// Unique email and throwaway password for this run\r\npm.environment.set(\"user_email\", `user_${Date.now()}@example.com`);\r\npm.environment.set(\"test_password\", `Test@${Date.now()}`);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"first_name\": \"{{$randomFirstName}}\",\n  \"last_name\": \"{{$randomLastName}}\",\n  \"address\": {\n    \"street\": \"{{$randomStreetAddress}}\",\n    \"house_number\": \"12\",\n    \"city\": \"Kathmandu\",\n    \"state\": \"Bagmati\",\n    \"country\": \"Nepal\",\n    \"postal_code\": \"44600\"\n  },\n  \"phone\": \"{{nepal_phone}}\",\n  \"dob\": \"1970-01-01\",\n  \"password\": \"{{test_password}}\",\n  \"email\": \"{{user_email}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/users/register",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "users",
            "register"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Login fillup",
