    {
      "name": "Product Search for Available Tools",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const res = pm.response.json();\r\n\r\nif (res.data && res.data.length > 0) {\r\n    pm.collectionVariables.set(\"product_id\", res.data[0].id);\r\n};\r\n\r\npm.test(\"Search status is 200 OK\", function (){\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\npm.test(\"Returned product match search query\", function () {\r\n    pm.expect(res.data[0].name.toLowerCase()).to.include(\"hammer\");\r\n    pm.expect(res.data).to.be.an(\"array\").that.is.not.empty;\r\n});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/products/search?q=hammer",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "products",
            "search"
          ],
          "query": [
            {
              "key": "q",
              "value": "hammer"
            }
          ]
        }
      },
      "response": []
